# Spotify OAuth Configuration
# Get your Client ID from: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your-client-id-here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/callback

# Server Configuration
BACKEND_ORIGIN=http://127.0.0.1:8000
FRONTEND_ORIGIN=http://127.0.0.1:5173

# Security
SESSION_SECRET=replace-with-a-long-random-local-secret

# Database
DATABASE_PATH=.data/quiz.db

# Development Mode (use fake Spotify for testing without credentials)
FAKE_SPOTIFY=false
# Frontend fake playback is opt-in for the credential-free demo only.
VITE_FAKE_SPOTIFY=false
